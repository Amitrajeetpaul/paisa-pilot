# Local dev: leave unset. Vite's dev-server proxy (vite.config.ts) forwards
# "/api" to http://localhost:8000, so the app works with no env var here.
#
# Production build only: set to the deployed api Cloud Run service's URL.
# Vite bakes this into the static JS at BUILD time, not read at runtime --
# see infra/web.Dockerfile and infra/deploy.md step 5.
VITE_API_BASE_URL=
