// The web app never talks to Firestore directly -- only api/ does, via the
// server-side google-cloud-firestore admin SDK (api/db/firestore.py),
// which authenticates with a service account and is NOT subject to these
// rules. These rules exist purely to deny any other access path (a
// leaked API key, a misconfigured client SDK, a future feature that
// forgets this boundary) -- the default-deny is the whole point.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
