# Copy to .env and fill in only what you need. Local dev works with NONE of
# these set -- READER_MODE defaults to "fixture" (see llm/reader.py), which
# never touches the network or needs an API key.

# Only needed if you set READER_MODE=live or GEMINI_PLAN_TIER=paid below.
GEMINI_API_KEY=

# Reader model (document extraction). Verified current as of 2026-11-19 --
# see DECISIONS.md if this ever needs re-checking against Google's docs.
GEMINI_READER_MODEL=gemini-3.8-flash

# Explainer model (AI Consultant), used only when GEMINI_PLAN_TIER=paid.
GEMINI_EXPLAINER_MODEL=gemini-4-argon

# "free" (default) always uses GEMINI_READER_MODEL for explanations too.
# "paid" uses GEMINI_EXPLAINER_MODEL, per the brief's paid-plan/fallback rule.
GEMINI_PLAN_TIER=free

# "fixture" (default) -- reads never hit the network, used by all tests and
# local dev. "live" -- calls the real Gemini API (needs GEMINI_API_KEY).
READER_MODE=fixture
