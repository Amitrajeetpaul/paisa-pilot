# Copy to .env and fill in only what you need. Local dev works with NONE of
# these set -- READER_MODE defaults to "fixture" (see llm/reader.py), which
# never touches the network or needs an API key.

# Only needed if you set READER_MODE=live or GEMINI_PLAN_TIER=paid below.
GEMINI_API_KEY=

# Reader model (document extraction). Verified current as of 2026-11-19 --
# see DECISIONS.md if this ever needs re-checking against Google's docs.
GEMINI_READER_MODEL=gemini-3.8-flash

# Explainer model (AI Consultant), used only when GEMINI_PLAN_TIER=paid.
GEMINI_EXPLAINER_MODEL=gemini-4-argon

# "free" (default) always uses GEMINI_READER_MODEL for explanations too.
# "paid" uses GEMINI_EXPLAINER_MODEL, per the brief's paid-plan/fallback rule.
GEMINI_PLAN_TIER=free

# "fixture" (default) -- reads AND the AI Consultant never hit the network,
# used by all tests and local dev. "live" -- calls the real Gemini API
# (needs GEMINI_API_KEY). Also read by agents/consultant.py and
# agents/guardrail.py's LLM-based second pass.
READER_MODE=fixture

# Upload storage: "local" (default, disk under LOCAL_STORAGE_DIR) or "gcs"
# (needs GCS_BUCKET and real GCP credentials).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.data/uploads
GCS_BUCKET=

# Confirmed fields + source trail: "sqlite" (default, file at SQLITE_PATH)
# or "firestore" (needs FIRESTORE_PROJECT and real GCP credentials).
DB_BACKEND=sqlite
SQLITE_PATH=./.data/paisa_pilot.db
FIRESTORE_PROJECT=

# Hours before an uploaded file is deleted (local: a sweep this app would
# schedule; GCS: enforced server-side by infra/cloud_storage_lifecycle.json).
UPLOAD_TTL_HOURS=24
